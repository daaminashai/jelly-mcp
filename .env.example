# --- Jelly login (needed for reading live state, search, and every action) ---
# Set with `npm run cookie` (see README). Never paste it anywhere else.
JELLY_SESSION_COOKIE=
# JELLY_BASE_URL=https://app.letsjelly.com
# JELLY_TEAM=hack-club
# JELLY_TIMEZONE=   (defaults to this computer's time zone; used for reply quotes)

# --- Marmalade (optional, read-only mirror of Jelly: date/status queries and the team list) ---
# MARMALADE_BASE_URL=https://marmalade.hackclub.com
MARMALADE_API_KEY=
# The mailbox list_mailbox_conversations uses by default, e.g. haven.
MARMALADE_MAILBOX=

# --- Safety ---
# 1 hides every tool that changes anything in Jelly.
JELLY_READ_ONLY=0
# 0 keeps drafting but hides send_reply and send_email.
JELLY_ALLOW_SEND=1
