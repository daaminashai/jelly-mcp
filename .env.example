# npm run setup fills this in for you. Everything here is optional to edit.

# Your Jelly login (npm run login refreshes it). Never share it.
JELLY_SESSION_COOKIE=
# JELLY_TEAM=hack-club   (found for you at login)

# Marmalade, optional: date/status queries and the team list. Get API key from marmalade.hackclub.com
MARMALADE_API_KEY=
MARMALADE_MAILBOX=

# Set to 1 so Claude can only read, never change anything in Jelly.
READ_ONLY=0
# Set to 1 so Claude can draft replies and emails but never send them.
DRAFT_ONLY_NO_SEND=0

# The always-on service (npm run service) makes its own token; change the port only if 4646 is taken.
# JELLY_MCP_PORT=4646
