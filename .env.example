# npm run setup fills this in for you. Everything here is optional to edit.

# Your Jelly login (npm run login refreshes it). Never share it.
JELLY_SESSION_COOKIE=
# JELLY_TEAM=hack-club   (found for you at login)

# Marmalade, optional: date/status queries and the team list.
MARMALADE_API_KEY=
MARMALADE_MAILBOX=

# 1 = Claude can only read, never change anything in Jelly.
JELLY_READ_ONLY=0
# 0 = Claude can draft but not send email.
JELLY_ALLOW_SEND=1
